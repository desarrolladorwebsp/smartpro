# Database
# Option A: full URL (encode special chars in password, e.g. @ -> %40)
DATABASE_URL=mysql://user:password@host:3306/smartpro_db
# Option B: individual vars (recommended on Vercel to avoid encoding issues)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
# DB_SSL=true
# DB_CONNECTION_URL=

# Session signing (required for dashboard auth)
ADMIN_SESSION_SECRET=

# Public app URLs (Mercado Pago requiere una URL pública HTTPS para back_urls y webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Transbank Webpay Plus
# integration (default) usa las credenciales públicas del SDK. production exige código y API key reales.
WEBPAY_ENV=integration
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# Mercado Pago Checkout Pro
# Public Key (frontend / Checkout Bricks). Access Token (Node SDK / preferencias).
# Las credenciales de prueba del panel también pueden empezar con APP_USR-.
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# API pública v1 (la consumen las subpáginas por servicio)
# Pimienta con la que se firman las claves de API y los secretos de webhook.
# Si cambia, todas las credenciales emitidas dejan de validar y hay que rotarlas.
# Sin definir, se usa ADMIN_SESSION_SECRET.
API_KEY_PEPPER=

# Email notifications (Resend)
EMAIL_TO= "Smart Pro <contacto@smartpro.cl>"
EMAIL_FROM= "Smart Pro <contacto@smartpro.cl>"
RESEND_API_KEY=
