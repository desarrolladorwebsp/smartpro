# Database
# Option A: full URL (encode special chars in password, e.g. @ -> %40)
DATABASE_URL=mysql://user:password@host:3306/smartpro_db
# Option B: individual vars (recommended on Vercel to avoid encoding issues)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
# DB_SSL=true
# DB_CONNECTION_URL=

# Session signing (required for dashboard auth)
ADMIN_SESSION_SECRET=

# Public app URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Transbank Webpay Plus
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# Email notifications (Resend)
EMAIL_TO= "Smart Pro <contacto@smartpro.cl>"
EMAIL_FROM= "Smart Pro <contacto@smartpro.cl>"
RESEND_API_KEY=