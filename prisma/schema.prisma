generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CLIENT
  EXECUTIVE
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  firstName       String
  lastName        String?
  businessName    String?
  rut             String?
  phone           String?
  passwordHash    String?
  role            UserRole    @default(CLIENT)
  status          UserStatus  @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  invitedInvitations Invitation[] @relation("InvitationInvitedBy")
  acceptedInvitations Invitation[] @relation("InvitationAcceptedBy")
  sessions           Session[]
  assignedClients    Client[]     @relation("ClientAssignedExecutive")
  sales              Sale[]       @relation("SaleExecutive")

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model Invitation {
  id          String            @id @default(cuid())
  email       String
  firstName   String
  lastName    String?
  role        UserRole
  token       String            @unique
  status      InvitationStatus  @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  acceptedAt  DateTime?

  invitedById String?
  invitedBy   User?   @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  acceptedById String?
  acceptedBy   User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ClientStatus {
  ACTIVO
  POTENCIAL
  INACTIVO
}

enum ClientCommercialStatus {
  PROSPECTO
  EN_SEGUIMIENTO
  CERRADO_PERDIDO
}

enum OrderStatus {
  pending
  confirmed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
}

enum PaymentMethod {
  simulated
  transbank
  mercadopago
  transfer
  cash
  other
}

enum ApiClientStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum ApiWebhookStatus {
  PENDING
  SENT
  FAILED
}

/// Aplicación externa autorizada a consumir la API pública (`/api/v1`).
/// Cada subpágina de servicio es un ApiClient con credenciales propias.
model ApiClient {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  publicKey          String          @unique
  secretHash         String          @unique
  secretPreview      String          @default("")
  status             ApiClientStatus @default(ACTIVE)
  scopes             Json            @default("[]")
  allowedOrigins     Json            @default("[]")
  allowedReturnUrls  Json            @default("[]")
  allowedServiceIds  Json            @default("[]")
  webhookUrl         String          @default("")
  rateLimitPerMinute Int             @default(120)
  contactEmail       String          @default("")
  notes              String          @default("") @db.Text
  lastUsedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  requestLogs       ApiRequestLog[]
  idempotencyKeys   ApiIdempotencyRecord[]
  webhookDeliveries ApiWebhookDelivery[]
  orders            Order[]
  sales             Sale[]
  clients           Client[]

  @@index([status])
}

model ApiRequestLog {
  id          String     @id @default(cuid())
  apiClientId String?
  apiClient   ApiClient? @relation(fields: [apiClientId], references: [id], onDelete: SetNull)
  method      String
  path        String     @db.Text
  status      Int
  errorCode   String     @default("")
  origin      String     @default("")
  ip          String     @default("")
  durationMs  Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([apiClientId, createdAt])
  @@index([createdAt])
}

/// Respuesta almacenada por `Idempotency-Key` para que un reintento de red
/// no genere un segundo cobro ni una segunda venta.
model ApiIdempotencyRecord {
  id           String    @id @default(cuid())
  apiClientId  String
  apiClient    ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  endpoint     String
  key          String
  requestHash  String
  status       Int
  responseBody Json
  createdAt    DateTime  @default(now())

  @@unique([apiClientId, endpoint, key])
  @@index([createdAt])
}

model ApiWebhookDelivery {
  id             String           @id @default(cuid())
  apiClientId    String
  apiClient      ApiClient        @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  event          String
  resourceId     String
  payload        Json
  status         ApiWebhookStatus @default(PENDING)
  attempts       Int              @default(0)
  responseStatus Int?
  lastError      String           @default("") @db.Text
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([apiClientId, event, resourceId])
  @@index([status, nextAttemptAt])
}

model Client {
  id               String       @id @default(cuid())
  companyName      String
  rut              String       @default("")
  contactFirstName String
  contactLastName  String
  email            String       @default("")
  phone            String       @default("")
  address          String       @default("")
  commune          String       @default("")
  city             String       @default("")
  region           String       @default("")
  website          String       @default("")
  notes            String       @default("") @db.Text
  status           ClientStatus @default(ACTIVO)
  commercialStatus ClientCommercialStatus @default(PROSPECTO)
  assignedExecutiveId String?
  assignedExecutive   User?     @relation("ClientAssignedExecutive", fields: [assignedExecutiveId], references: [id], onDelete: SetNull)
  interestServiceId          String?
  interestServiceName        String  @default("")
  interestSubcategoryId      String?
  interestSubcategoryName    String  @default("")
  interestPlanId             String?
  interestPlanName           String  @default("")
  interestService            ServiceCategory?    @relation("ClientInterestService", fields: [interestServiceId], references: [id], onDelete: SetNull)
  interestSubcategory        ServiceSubcategory? @relation("ClientInterestSubcategory", fields: [interestSubcategoryId], references: [id], onDelete: SetNull)
  interestPlan               ServicePlan?        @relation("ClientInterestPlan", fields: [interestPlanId], references: [id], onDelete: SetNull)
  apiClientId      String?
  apiClient        ApiClient?   @relation(fields: [apiClientId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  clientNotes    ClientNote[]
  initialContact InitialContact?
  quotes         Quote[]
  sales          Sale[]

  @@index([email])
  @@index([status])
  @@index([commercialStatus])
  @@index([assignedExecutiveId])
  @@index([rut])
  @@index([interestServiceId])
  @@index([interestSubcategoryId])
  @@index([interestPlanId])
  @@index([apiClientId])
}

model ClientNote {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String   @default("")
  content        String   @db.Text
  executiveEmail String
  createdAt      DateTime @default(now())

  @@index([clientId])
}

model InitialContact {
  id             String   @id @default(cuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  executiveEmail String
  type           String   @default("CONTACTO_INICIAL")
  origin         String
  quoteMotive    String
  firstName      String
  lastName       String
  phone          String   @default("")
  email          String   @default("")
  companyName    String
  website        String   @default("")
  socialMedia    String   @default("")
  observation    String   @default("") @db.Text
  createdAt      DateTime @default(now())
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

model ServiceCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @default("") @db.Text
  coverImage  String        @default("")
  coverMime   String        @default("")
  coverBytes  Bytes?        @db.MediumBlob
  sortOrder   Int           @default(0)
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subcategories ServiceSubcategory[]
  interestedClients Client[] @relation("ClientInterestService")
  portfolioProjects PortfolioProject[]

  @@index([status])
  @@index([sortOrder])
}

model ServiceSubcategory {
  id         String        @id @default(cuid())
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  sortOrder  Int           @default(0)
  status     CatalogStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  plans ServicePlan[]
  interestedClients Client[] @relation("ClientInterestSubcategory")
  portfolioProjects PortfolioProject[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([status])
}

model ServicePlan {
  coverImage String @default("")
  id                String        @id @default(cuid())
  subcategoryId     String
  subcategory       ServiceSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  price             Decimal       @db.Decimal(12, 2)
  pricePrefix       String        @default("")
  taxLabel          String        @default("+ IVA")
  taxRate           Decimal       @default(0.19) @db.Decimal(5, 4)
  summary           String        @default("") @db.Text
  badge             String        @default("")
  note              String        @default("") @db.Text
  featureGroupTitle String        @default("")
  highlighted       Boolean       @default(false)
  sortOrder         Int           @default(0)
  status            CatalogStatus @default(ACTIVE)
  icon              String        @default("")
  externalLink      String        @default("")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items ServicePlanItem[]
  quoteItems QuoteItem[]
  interestedClients Client[] @relation("ClientInterestPlan")

  @@unique([subcategoryId, slug])
  @@index([subcategoryId])
  @@index([status])
  @@index([highlighted])
  @@index([sortOrder])
}

model ServicePlanItem {
  id        String        @id @default(cuid())
  planId    String
  plan      ServicePlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  label     String        @db.Text
  slug      String
  sortOrder Int           @default(0)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([planId, slug])
  @@index([planId])
}

model Order {
  id                      String        @id @default(cuid())
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  orderStatus             OrderStatus   @default(pending)
  customerName            String
  customerEmail           String
  customerPhone           String
  customerCompany         String?
  subtotal                Decimal       @db.Decimal(12, 2)
  tax                     Decimal       @db.Decimal(12, 2)
  total                   Decimal       @db.Decimal(12, 2)
  paymentStatus           PaymentStatus @default(pending)
  paymentMethod           PaymentMethod @default(transbank)
  preferenceId            String?       @unique
  mercadopagoPaymentId    String?       @unique
  webpayToken             String?       @unique
  processedPaymentKeys    Json          @default("[]")
  notificationEmailSentAt DateTime?
  quoteId                 String?
  quote                   Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  apiClientId             String?
  apiClient               ApiClient?    @relation(fields: [apiClientId], references: [id], onDelete: SetNull)
  apiReturnUrl            String        @default("")
  apiExternalReference    String        @default("")
  items                   OrderItem[]
  sale                    Sale?
  salePayments            SalePayment[]

  @@index([customerEmail])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([quoteId])
  @@index([apiClientId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId    String?
  name         String
  category     String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  priceDisplay String?
  taxRate      Decimal @default(0.19) @db.Decimal(5, 4)
  source       String?
  subtotal     Decimal @db.Decimal(12, 2)
  tax          Decimal @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

enum PortfolioProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PortfolioProject {
  id            String                 @id @default(cuid())
  categoryId    String
  category      ServiceCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId String
  subcategory   ServiceSubcategory     @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  title         String
  slug          String
  summary       String                 @default("") @db.Text
  image         String                 @default("")
  imageMime     String                 @default("")
  imageBytes    Bytes?                 @db.MediumBlob
  url           String                 @default("")
  tags          Json                   @default("[]")
  status        PortfolioProjectStatus @default(DRAFT)
  sortOrder     Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, status, sortOrder])
  @@index([subcategoryId])
}

enum QuoteStatus {
  DRAFT
  CREATED
  SENT
  ACCEPTED
  REJECTED
}

enum QuoteDiscountType {
  NONE
  PERCENT
  AMOUNT
}

model Quote {
  id             String      @id @default(cuid())
  number         String      @unique
  status         QuoteStatus @default(DRAFT)
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByEmail String
  notes                   String      @default("") @db.Text
  validUntil              DateTime?
  deliveryBusinessDays    Int         @default(15)
  initialPaymentPercent   Int         @default(50)
  discountType            QuoteDiscountType @default(NONE)
  discountValue           Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount          Decimal     @default(0) @db.Decimal(12, 2)
  subtotal                Decimal     @db.Decimal(12, 2)
  tax            Decimal     @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          QuoteItem[]
  orders         Order[]
  sale           Sale?

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id              String       @id @default(cuid())
  quoteId         String
  quote           Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  planId          String?
  plan            ServicePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName        String
  categoryName    String
  subcategoryName String
  quantity        Int
  unitPrice       Decimal      @db.Decimal(12, 2)
  taxRate         Decimal      @default(0.19) @db.Decimal(5, 4)
  includedItems   Json
  subtotal        Decimal      @db.Decimal(12, 2)
  tax             Decimal      @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  sortOrder       Int          @default(0)

  @@index([quoteId])
  @@index([planId])
}

enum SaleStatus {
  REGISTERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SaleSource {
  MANUAL
  QUOTE_ACCEPTED
  ORDER_PAID
  EXTERNAL_API
}

enum LiorenInvoiceStatus {
  NOT_ISSUED
  ISSUING
  ISSUED
  ERROR
}

model Sale {
  id               String          @id @default(cuid())
  number           String          @unique
  status           SaleStatus      @default(REGISTERED)
  source           SaleSource      @default(MANUAL)
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quoteId          String?         @unique
  quote            Quote?          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  orderId          String?         @unique
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod?
  executiveId      String?
  executive        User?           @relation("SaleExecutive", fields: [executiveId], references: [id], onDelete: SetNull)
  apiClientId      String?
  apiClient        ApiClient?      @relation(fields: [apiClientId], references: [id], onDelete: SetNull)
  externalReference String         @default("")
  createdByEmail   String
  soldAt           DateTime        @default(now())
  observation      String          @default("") @db.Text
  receiptPath      String          @default("")
  receiptFileName  String          @default("")
  subtotal         Decimal         @db.Decimal(12, 2)
  tax              Decimal         @db.Decimal(12, 2)
  total            Decimal         @db.Decimal(12, 2)
  liorenInvoiceStatus       LiorenInvoiceStatus @default(NOT_ISSUED)
  liorenInvoiceType         String?             @db.VarChar(3)
  liorenInvoiceDocumentId   Int?
  liorenInvoiceFolio        Int?
  liorenInvoiceIssuedAt     DateTime?
  liorenInvoiceDraft        String?             @db.LongText
  liorenInvoiceError        String?             @db.Text
  liorenInvoicePdf          String?             @db.LongText
  liorenInvoiceEmailSentAt  DateTime?
  liorenInvoiceEmailError   String?             @db.Text
  archivedAt                DateTime?
  archivedByEmail           String?             @db.VarChar(255)
  archiveReason             String?             @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  payments         SalePayment[]
  internalComments SaleInternalComment[]

  @@index([clientId])
  @@index([executiveId])
  @@index([status])
  @@index([soldAt])
  @@index([apiClientId])
  @@index([archivedAt])
}

enum SalePaymentSource {
  ORDER_PAID
  MANUAL
  EXTERNAL_API
}

model SalePayment {
  id              String            @id @default(cuid())
  saleId          String
  sale            Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount          Decimal           @db.Decimal(12, 2)
  method          PaymentMethod
  paidAt          DateTime          @default(now())
  receiptPath     String            @default("")
  receiptFileName String            @default("")
  orderId         String?           @unique
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  source          SalePaymentSource @default(MANUAL)
  createdByEmail  String
  observation     String            @default("") @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([saleId])
  @@index([paidAt])
}

/// Private, durable payment receipts. SalePayment.receiptPath points to the authenticated media route.
model SaleReceipt {
  id        String   @id @db.VarChar(36)
  fileName  String   @db.VarChar(191)
  mimeType  String   @db.VarChar(64)
  bytes     Bytes    @db.MediumBlob
  createdAt DateTime @default(now())
}

/// Comentarios internos visibles solo para usuarios del panel.
model SaleInternalComment {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  authorEmail    String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  @@index([saleId, createdAt])
}

enum AdminNotificationType {
  CLIENT_CREATED
  QUOTE_CREATED
  QUOTE_SENT
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  ORDER_CREATED
  ORDER_PAID
  SALE_REGISTERED
  PAYMENT_RECEIVED
}

/// Avisos del panel administrativo: inbox compartido del equipo.
model AdminNotification {
  id         String                 @id @default(cuid())
  type       AdminNotificationType
  title      String
  body       String                 @db.Text
  href       String                 @default("")
  entityType String                 @default("")
  entityId   String                 @default("")
  dedupeKey  String                 @unique
  readAt     DateTime?
  createdAt  DateTime               @default(now())

  @@index([createdAt])
  @@index([readAt])
  @@index([type])
}
