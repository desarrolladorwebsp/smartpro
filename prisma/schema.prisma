generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CLIENT
  EXECUTIVE
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  firstName       String
  lastName        String?
  businessName    String?
  rut             String?
  phone           String?
  passwordHash    String?
  role            UserRole    @default(CLIENT)
  status          UserStatus  @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  invitedInvitations Invitation[] @relation("InvitationInvitedBy")
  acceptedInvitations Invitation[] @relation("InvitationAcceptedBy")
  sessions           Session[]

  @@index([email])
  @@index([role])
}

model Invitation {
  id          String            @id @default(cuid())
  email       String
  firstName   String
  lastName    String?
  role        UserRole
  token       String            @unique
  status      InvitationStatus  @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  acceptedAt  DateTime?

  invitedById String?
  invitedBy   User?   @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  acceptedById String?
  acceptedBy   User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ClientStatus {
  ACTIVO
  POTENCIAL
  INACTIVO
}

enum OrderStatus {
  pending
  confirmed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
}

enum PaymentMethod {
  simulated
  transbank
  mercadopago
}

model Client {
  id               String       @id @default(cuid())
  companyName      String
  rut              String       @unique
  contactFirstName String
  contactLastName  String
  email            String       @default("")
  phone            String       @default("")
  address          String       @default("")
  commune          String       @default("")
  city             String       @default("")
  region           String       @default("")
  website          String       @default("")
  notes            String       @default("") @db.Text
  status           ClientStatus @default(ACTIVO)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  clientNotes    ClientNote[]
  initialContact InitialContact?

  @@index([email])
  @@index([status])
}

model ClientNote {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String   @default("")
  content        String   @db.Text
  executiveEmail String
  createdAt      DateTime @default(now())

  @@index([clientId])
}

model InitialContact {
  id             String   @id @default(cuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  executiveEmail String
  type           String   @default("CONTACTO_INICIAL")
  origin         String
  quoteMotive    String
  firstName      String
  lastName       String
  phone          String   @default("")
  email          String   @default("")
  companyName    String
  website        String   @default("")
  socialMedia    String   @default("")
  observation    String   @default("") @db.Text
  createdAt      DateTime @default(now())
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

model ServiceCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @default("") @db.Text
  sortOrder   Int           @default(0)
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subcategories ServiceSubcategory[]

  @@index([status])
  @@index([sortOrder])
}

model ServiceSubcategory {
  id         String        @id @default(cuid())
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  sortOrder  Int           @default(0)
  status     CatalogStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  plans ServicePlan[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([status])
}

model ServicePlan {
  id                String        @id @default(cuid())
  subcategoryId     String
  subcategory       ServiceSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  price             Decimal       @db.Decimal(12, 2)
  pricePrefix       String        @default("")
  taxLabel          String        @default("+ IVA")
  taxRate           Decimal       @default(0.19) @db.Decimal(5, 4)
  summary           String        @default("") @db.Text
  badge             String        @default("")
  note              String        @default("") @db.Text
  featureGroupTitle String        @default("")
  highlighted       Boolean       @default(false)
  sortOrder         Int           @default(0)
  status            CatalogStatus @default(ACTIVE)
  icon              String        @default("")
  externalLink      String        @default("")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items ServicePlanItem[]

  @@unique([subcategoryId, slug])
  @@index([subcategoryId])
  @@index([status])
  @@index([highlighted])
  @@index([sortOrder])
}

model ServicePlanItem {
  id        String        @id @default(cuid())
  planId    String
  plan      ServicePlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  label     String        @db.Text
  slug      String
  sortOrder Int           @default(0)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([planId, slug])
  @@index([planId])
}

model Order {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  orderStatus     OrderStatus   @default(pending)
  customerName    String
  customerEmail   String
  customerPhone   String
  customerCompany String?
  subtotal        Decimal       @db.Decimal(12, 2)
  tax             Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(pending)
  paymentMethod   PaymentMethod @default(transbank)
  items           OrderItem[]

  @@index([customerEmail])
  @@index([orderStatus])
  @@index([paymentStatus])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId    String?
  name         String
  category     String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  priceDisplay String?
  taxRate      Decimal @default(0.19) @db.Decimal(5, 4)
  source       String?
  subtotal     Decimal @db.Decimal(12, 2)
  tax          Decimal @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)

  @@index([orderId])
}
