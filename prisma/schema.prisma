generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CLIENT
  EXECUTIVE
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  firstName       String
  lastName        String?
  businessName    String?
  rut             String?
  phone           String?
  passwordHash    String?
  role            UserRole    @default(CLIENT)
  status          UserStatus  @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  invitedInvitations Invitation[] @relation("InvitationInvitedBy")
  acceptedInvitations Invitation[] @relation("InvitationAcceptedBy")
  sessions           Session[]
  assignedClients    Client[]     @relation("ClientAssignedExecutive")
  sales              Sale[]       @relation("SaleExecutive")

  @@index([email])
  @@index([role])
}

model Invitation {
  id          String            @id @default(cuid())
  email       String
  firstName   String
  lastName    String?
  role        UserRole
  token       String            @unique
  status      InvitationStatus  @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  acceptedAt  DateTime?

  invitedById String?
  invitedBy   User?   @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  acceptedById String?
  acceptedBy   User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ClientStatus {
  ACTIVO
  POTENCIAL
  INACTIVO
}

enum ClientCommercialStatus {
  PROSPECTO
  EN_SEGUIMIENTO
  CERRADO_PERDIDO
}

enum OrderStatus {
  pending
  confirmed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
}

enum PaymentMethod {
  simulated
  transbank
  mercadopago
}

model Client {
  id               String       @id @default(cuid())
  companyName      String
  rut              String       @default("")
  contactFirstName String
  contactLastName  String
  email            String       @default("")
  phone            String       @default("")
  address          String       @default("")
  commune          String       @default("")
  city             String       @default("")
  region           String       @default("")
  website          String       @default("")
  notes            String       @default("") @db.Text
  status           ClientStatus @default(ACTIVO)
  commercialStatus ClientCommercialStatus @default(PROSPECTO)
  assignedExecutiveId String?
  assignedExecutive   User?     @relation("ClientAssignedExecutive", fields: [assignedExecutiveId], references: [id], onDelete: SetNull)
  interestServiceId          String?
  interestServiceName        String  @default("")
  interestSubcategoryId      String?
  interestSubcategoryName    String  @default("")
  interestPlanId             String?
  interestPlanName           String  @default("")
  interestService            ServiceCategory?    @relation("ClientInterestService", fields: [interestServiceId], references: [id], onDelete: SetNull)
  interestSubcategory        ServiceSubcategory? @relation("ClientInterestSubcategory", fields: [interestSubcategoryId], references: [id], onDelete: SetNull)
  interestPlan               ServicePlan?        @relation("ClientInterestPlan", fields: [interestPlanId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  clientNotes    ClientNote[]
  initialContact InitialContact?
  quotes         Quote[]
  sales          Sale[]

  @@index([email])
  @@index([status])
  @@index([commercialStatus])
  @@index([assignedExecutiveId])
  @@index([rut])
  @@index([interestServiceId])
  @@index([interestSubcategoryId])
  @@index([interestPlanId])
}

model ClientNote {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String   @default("")
  content        String   @db.Text
  executiveEmail String
  createdAt      DateTime @default(now())

  @@index([clientId])
}

model InitialContact {
  id             String   @id @default(cuid())
  clientId       String   @unique
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  executiveEmail String
  type           String   @default("CONTACTO_INICIAL")
  origin         String
  quoteMotive    String
  firstName      String
  lastName       String
  phone          String   @default("")
  email          String   @default("")
  companyName    String
  website        String   @default("")
  socialMedia    String   @default("")
  observation    String   @default("") @db.Text
  createdAt      DateTime @default(now())
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

model ServiceCategory {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String        @default("") @db.Text
  coverImage  String        @default("")
  coverMime   String        @default("")
  coverBytes  Bytes?        @db.MediumBlob
  sortOrder   Int           @default(0)
  status      CatalogStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subcategories ServiceSubcategory[]
  interestedClients Client[] @relation("ClientInterestService")
  portfolioProjects PortfolioProject[]

  @@index([status])
  @@index([sortOrder])
}

model ServiceSubcategory {
  id         String        @id @default(cuid())
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  sortOrder  Int           @default(0)
  status     CatalogStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  plans ServicePlan[]
  interestedClients Client[] @relation("ClientInterestSubcategory")
  portfolioProjects PortfolioProject[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([status])
}

model ServicePlan {
  id                String        @id @default(cuid())
  subcategoryId     String
  subcategory       ServiceSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  price             Decimal       @db.Decimal(12, 2)
  pricePrefix       String        @default("")
  taxLabel          String        @default("+ IVA")
  taxRate           Decimal       @default(0.19) @db.Decimal(5, 4)
  summary           String        @default("") @db.Text
  badge             String        @default("")
  note              String        @default("") @db.Text
  featureGroupTitle String        @default("")
  highlighted       Boolean       @default(false)
  sortOrder         Int           @default(0)
  status            CatalogStatus @default(ACTIVE)
  icon              String        @default("")
  externalLink      String        @default("")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items ServicePlanItem[]
  quoteItems QuoteItem[]
  interestedClients Client[] @relation("ClientInterestPlan")

  @@unique([subcategoryId, slug])
  @@index([subcategoryId])
  @@index([status])
  @@index([highlighted])
  @@index([sortOrder])
}

model ServicePlanItem {
  id        String        @id @default(cuid())
  planId    String
  plan      ServicePlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  label     String        @db.Text
  slug      String
  sortOrder Int           @default(0)
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([planId, slug])
  @@index([planId])
}

model Order {
  id                      String        @id @default(cuid())
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  orderStatus             OrderStatus   @default(pending)
  customerName            String
  customerEmail           String
  customerPhone           String
  customerCompany         String?
  subtotal                Decimal       @db.Decimal(12, 2)
  tax                     Decimal       @db.Decimal(12, 2)
  total                   Decimal       @db.Decimal(12, 2)
  paymentStatus           PaymentStatus @default(pending)
  paymentMethod           PaymentMethod @default(transbank)
  preferenceId            String?       @unique
  mercadopagoPaymentId    String?       @unique
  webpayToken             String?       @unique
  processedPaymentKeys    Json          @default("[]")
  notificationEmailSentAt DateTime?
  quoteId                 String?
  quote                   Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items                   OrderItem[]
  sale                    Sale?

  @@index([customerEmail])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([quoteId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId    String?
  name         String
  category     String
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  priceDisplay String?
  taxRate      Decimal @default(0.19) @db.Decimal(5, 4)
  source       String?
  subtotal     Decimal @db.Decimal(12, 2)
  tax          Decimal @db.Decimal(12, 2)
  total        Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

enum PortfolioProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PortfolioProject {
  id            String                 @id @default(cuid())
  categoryId    String
  category      ServiceCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId String
  subcategory   ServiceSubcategory     @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  title         String
  slug          String
  summary       String                 @default("") @db.Text
  image         String                 @default("")
  imageMime     String                 @default("")
  imageBytes    Bytes?                 @db.MediumBlob
  url           String                 @default("")
  tags          Json                   @default("[]")
  status        PortfolioProjectStatus @default(DRAFT)
  sortOrder     Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, status, sortOrder])
  @@index([subcategoryId])
}

enum QuoteStatus {
  DRAFT
  CREATED
  SENT
  ACCEPTED
  REJECTED
}

model Quote {
  id             String      @id @default(cuid())
  number         String      @unique
  status         QuoteStatus @default(DRAFT)
  clientId       String
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByEmail String
  notes                   String      @default("") @db.Text
  validUntil              DateTime?
  deliveryBusinessDays    Int         @default(15)
  initialPaymentPercent   Int         @default(50)
  subtotal                Decimal     @db.Decimal(12, 2)
  tax            Decimal     @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          QuoteItem[]
  orders         Order[]
  sale           Sale?

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model QuoteItem {
  id              String       @id @default(cuid())
  quoteId         String
  quote           Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  planId          String?
  plan            ServicePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName        String
  categoryName    String
  subcategoryName String
  quantity        Int
  unitPrice       Decimal      @db.Decimal(12, 2)
  taxRate         Decimal      @default(0.19) @db.Decimal(5, 4)
  includedItems   Json
  subtotal        Decimal      @db.Decimal(12, 2)
  tax             Decimal      @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  sortOrder       Int          @default(0)

  @@index([quoteId])
  @@index([planId])
}

enum SaleStatus {
  REGISTERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SaleSource {
  MANUAL
  QUOTE_ACCEPTED
  ORDER_PAID
}

model Sale {
  id               String          @id @default(cuid())
  number           String          @unique
  status           SaleStatus      @default(REGISTERED)
  source           SaleSource      @default(MANUAL)
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quoteId          String?         @unique
  quote            Quote?          @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  orderId          String?         @unique
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  paymentMethod    PaymentMethod?
  executiveId      String?
  executive        User?           @relation("SaleExecutive", fields: [executiveId], references: [id], onDelete: SetNull)
  createdByEmail   String
  soldAt           DateTime        @default(now())
  observation      String          @default("") @db.Text
  receiptPath      String          @default("")
  receiptFileName  String          @default("")
  subtotal         Decimal         @db.Decimal(12, 2)
  tax              Decimal         @db.Decimal(12, 2)
  total            Decimal         @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([clientId])
  @@index([executiveId])
  @@index([status])
  @@index([soldAt])
}
